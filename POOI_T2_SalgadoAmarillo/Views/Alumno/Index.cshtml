@model IEnumerable<POOI_T2_SalgadoAmarillo.Models.Alumno>
@{
    ViewBag.Title = "Alumnos";
}

<h2>Alumnos</h2>
<p>@Html.ActionLink("Agregar alumno", "Agregar")</p>

@using (Html.BeginForm("Serializar", "Alumno", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <button type="submit">Serializar</button>
}

@if (TempData["Mensaje"] != null)
{
    <p id="mensaje">@TempData["Mensaje"]</p>
    <script>
        setTimeout(function () {
            document.getElementById("mensaje").style.display = "none";
        }, 5000);
    </script>
}

<table>
    <thead>
        <tr>
            <th>DNI</th>
            <th>Nombres</th>
            <th>Apellidos</th>
            <th>Carrera</th>
            <th>Ciclo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var alumno in Model)
        {
            <tr>
                <td>@alumno.dni</td>
                <td>@alumno.nombres</td>
                <td>@alumno.apellidos</td>
                <td>@alumno.carrera</td>
                <td>@alumno.ciclo</td>
                <td>
                    @Html.ActionLink("Detalles", "Detalles", new { dni = alumno.dni }) |
                    @Html.ActionLink("Actualizar", "Actualizar", new { dni = alumno.dni })
                    @using (Html.BeginForm("Eliminar", "Alumno", FormMethod.Post, new { @class = "en-linea" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("dni", alumno.dni)
                        <button type="submit">Eliminar</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
